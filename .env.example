# Configure public Supabase values BEFORE building Next.js. Never put secrets in NEXT_PUBLIC_*.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Private server-to-server configuration. Generate a real key: openssl rand -hex 32
NLP_SERVICE_URL=http://127.0.0.1:8000
NLP_SERVICE_API_KEY=
NLP_ENABLE_EMBEDDINGS=true
SPACY_MODEL=en_core_web_sm
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_REVISION=c9745ed1d9f207416be6d2e6f8de32d1f16199bf
# Optional absolute model cache path; default is nlp-service/.model-cache/hub.
# NLP_MODEL_CACHE=/absolute/path/to/fluentfive/nlp-service/.model-cache/hub

# Optional broader grammar checking. Self-host for private transcripts in production.
# Setting this URL sends learner text to that service. Empty = conservative local rules.
LANGUAGETOOL_URL=

# Optional contextual explanations, speaking prompts, and writing polish.
OPENROUTER_API_KEY=
OPENROUTER_MODEL_FAST=openai/gpt-4o-mini
OPENROUTER_MODEL_DEEP=openai/gpt-4o

# Optional shadowing reference audio. Local recording and browser voice work without it.
ELEVENLABS_API_KEY=

# Only the optional seed-db.js script needs this; the application does not use it.
# SUPABASE_SERVICE_ROLE_KEY=
